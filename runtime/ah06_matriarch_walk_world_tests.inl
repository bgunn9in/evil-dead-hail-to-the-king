// Real movement and source combat; no Ash/NPC pose fixtures. Original method1531
// skips the pending attack if its NPC HP changes during the authored windup.
void continueAH06MatriarchWalkWorld(World& world) {
    std::cout<<std::unitbuf;auto& vm=world.game.vm;
    const unsigned previousTransitions=world.transitions;
    auto quantity=[&](int id){int n=0;
        for(int container:{98,99,100})for(const auto&e:world.game.items(container))if(e.itemID==id)n+=e.quantity;
        return n;
    };
    if(world.scene.id!="ah06"||vm.staticField(604).integer()||vm.staticField(452).integer()||!world.actors->bodies().count({14,0})||vm.field(world.actors->at({14,0}).script,13).integer()!=100||quantity(9)!=0)throw std::runtime_error("AH06 requires the same earned unsolved arrival");
    useSourceHealingItem(world);
    const auto bossKey=edactors::Key{14,0};
    const auto boss=world.actors->at(bossKey).script,saw=vm.field(world.game.ash,102).reference();
    unsigned frames=0,hits=0;
    float displacement=0;
    int hp=vm.field(world.game.ash,13).integer(),enemyHP=vm.field(boss,13).integer();
    bool combatAim=true;
    auto pointClear=[&](Vec2 point){if(!floorHeight(world.scene.floor,point))return false;
        for(const auto&g:world.scene.ground){if(!g.enabled)continue;
            if(!g.boundaryOnly&&g.sourceIndex<world.scene.queries.volumes.size()&&world.scene.queries.volumes[g.sourceIndex].geometry.kind==2&&!(world.scene.queries.volumes[g.sourceIndex].flags&2))continue;
            if(!clearGround(std::vector<GroundPolygon>{g},point,0))return false;
        }return true;
    };
    auto toward=[&](Vec2 target,float mag){const auto&c=world.scene.cameras.at(world.actor.camera);
        const auto&l=world.actor.movement;
        const Vec2 r=l.held?l.right:c.right,f=l.held?l.forward:c.forward,d=target-Vec2{world.actor.position[0],world.actor.position[2]};
        const float det=r.x*f.z-r.z*f.x;
        if(std::abs(det)<.001f)throw std::runtime_error("AH06 camera singular");
        const Vec2 stick{(d.x*f.z-d.z*f.x)/det,(r.x*d.z-r.z*d.x)/det};
        const float size=length(stick);
        return size>.000001f?stick*(mag/size):Vec2{};
    };
    auto tick=[&](Vec2 stick,bool attack,float dt=.033f){const Vec2 old{world.actor.position[0],world.actor.position[2]};
        ControlFrame input;
        input.movement=stick;
        input.down[size_t(ControlAction::Aim)]=combatAim;
        input.edges[size_t(ControlAction::PrimaryAttack)]=attack&&dt>0&&world.sourceTick%6==0;
        input.edges[size_t(ControlAction::ChainsawRev)]=combatAim&&vm.field(saw,815).integer()>=2&&(vm.field(saw,139).integer()==0||vm.field(saw,139).integer()==2);
        if(dt>0){useSourceHealingItem(world);useSourceOwnedFuelItem(world);}
        world.playerControls(input);
        const auto move=world.step(stick,true,false,dt);
        if(world.scriptFault)throw std::runtime_error(world.game.diagnostic);
        if(move.requested>std::min(1.f,length(stick))*world.scene.speed*2*frameSeconds(dt)+ContactSkin*4)throw std::runtime_error("AH06 requested motion exceeded inputbound");
        const int h=vm.field(world.game.ash,13).integer(),nh=vm.field(boss,13).integer();
        if(h<hp){std::cout<<"AH06 incoming "<<hp<<"->"<<h<<" tick"<<world.sourceTick<<" NPCstate"<<world.actors->at(bossKey).actions.layers[0].state<<'\n';
        }hp=h;
        if(nh<enemyHP){++hits;
            std::cout<<"AH06 actualprimary damage "<<enemyHP<<"->"<<nh<<" tick"<<world.sourceTick<<" HeroHP"<<h<<" fuel"<<vm.field(saw,815).integer()<<'\n';
        }enemyHP=nh;
        if(h<=0){throw std::runtime_error("AH06 naturaldeath inputcontroller");
        }const Vec2 now{world.actor.position[0],world.actor.position[2]};
        displacement+=length(now-old);
        frames+=dt>0;
        if(!pointClear(now)){throw std::runtime_error("AH06 actualwalk leftfloor/P1solid");
        }};
    for(unsigned n=0;n<2400&&!vm.staticField(604).integer();++n){if(world.game.mode!=0)world.closeInventory();
        const auto&b=world.actors->at(bossKey);
        const Vec2 at{world.actor.position[0],world.actor.position[2]},npc{b.pose.x,b.pose.z};
        const float d=length(at-npc);
        if(enemyHP<=0){tick({},false);
            continue;
        }if((b.actions.possible(44)||b.actions.possible(45))&&d<2.7f){tick(toward(npc,1),false,0);
            tick({},true);
            continue;
        }Vec2 goal{};
        bool found=false;
        float nearest=1e30f;
        for(float side:{edactormath::HalfPi,-edactormath::HalfPi})for(float offset:{0.f,-.174532925f,.174532925f}){const float angle=b.pose.yaw+side+offset;
            const Vec2 q{npc.x+2.2f*std::sin(angle),npc.z+2.2f*std::cos(angle)};
            if(!pointClear(q))continue;
            const float len=length(q-at);
            if(len<nearest){nearest=len;
                goal=q;
                found=true;
            }}if(!found){throw std::runtime_error("AH06 no legal boundedside goal");
        }tick(toward(goal,std::min(1.f,nearest/(world.scene.speed*2*.033f))),false);
    }
    if(!vm.staticField(604).integer()){throw std::runtime_error("AH06 boundedactualfight did not defeatMatriarch");
    }for(unsigned n=0;n<240&&!vm.staticField(452).integer();++n){if(world.game.mode!=0)world.closeInventory();
        tick({},false);
    }std::cout<<"AH06 reward604="<<vm.staticField(604).integer()<<" 452="<<vm.staticField(452).integer()<<" qty73="<<quantity(73)<<" qty132="<<quantity(132)<<" mode"<<world.game.mode<<"\n";
    if(!vm.staticField(452).integer()||quantity(73)!=1||quantity(132)!=1)throw std::runtime_error("Original604 rewards73/132 absent");
    std::cout<<"AH06 actualinput Matriarch604/73/132 PASS "<<frames<<" frames "<<displacement<<"m "<<hits<<" hits HP"<<hp<<'\n';
    combatAim=false;
    auto ready=[&](){for(unsigned n=0;n<360;++n){if(world.game.mode!=0)world.closeInventory();
            world.playerControls({});
            const auto&ash=world.actors->at({0,0});
            if(!(ash.flags&0x48)&&!world.guard&&!vm.field(world.game.ash,11).integer()&&!vm.field(world.game.ash,123).integer()&&!vm.staticField(71).integer()&&vm.staticField(844).integer()==0&&ash.actions.possible(116))return;
            tick({},false);
        }throw std::runtime_error("AH06 sourceinput did not settle");
    };
    auto nav=[&](unsigned i){uint32_t n,o;
        std::memcpy(&n,world.scene.nativeBytes.data()+48,4);
        std::memcpy(&o,world.scene.nativeBytes.data()+52,4);
        if(i>=n)throw std::runtime_error("AH06 sourceNav absent");
        GroundPoint q;
        std::memcpy(&q,world.scene.nativeBytes.data()+o+i*44+8,12);
        return Vec2{q.x,q.z};
    };
    auto walk=[&](Vec2 goal){tick({},false,0);
        for(unsigned n=0;n<1000;++n){if(world.game.mode!=0)ready();
            const float d=length(goal-Vec2{world.actor.position[0],world.actor.position[2]});
            if(d<.04f){tick({},false,0);
                return;
            }tick(toward(goal,std::min(1.f,d/(world.scene.speed*2*.033f))),false);
        }throw std::runtime_error("AH06 authoredreturn leg stalled");
    };
    ready();
    const bool west=world.actor.position[0]<-17.27f;
    const std::vector<unsigned>nodes=west?std::vector<unsigned>{20,21,22,23,24,25,26}:std::vector<unsigned>{6,7,8,9,10,11,12};
    for(auto i:nodes){const auto goal=nav(i);
        if(goal.z>world.actor.position[2]+.25f)walk(goal);
    }walk({-17.166933f,-2.279392f});
    ready();
    if(!world.scene.scripting.inside(12,{world.actor.position[0],world.actors->at({0,0}).localY,world.actor.position[2]}))throw std::runtime_error("AH06 actualreturn missedvolume12");
    ControlFrame use;
    use.edges[size_t(ControlAction::Use)]=true;
    world.playerControls(use);
    world.step({},false,true,0);
    if(!world.pendingSceneSwitch)throw std::runtime_error("AH06 originalallowUse1980 did notqueue");
    const auto request=*world.pendingSceneSwitch;
    if(request.sourceSceneId!=0x61680600u||request.destinationId!=0x61680500u||request.camera!=1||request.marker!=1||request.rotationXYZ!=std::array<float,3>{{0,0,0}})throw std::runtime_error("AH06 originalreturntuple differs");
    world.pendingSceneSwitch.reset();
    if(!world.switchScene(request,nullptr)||world.scene.id!="ah05"||world.transitions!=previousTransitions+1)throw std::runtime_error("AH06 queuedreturn didnotenterAH05");
    unsigned fadeFrames=0;
    const auto fadeStart=world.sourceScreen.fadeInProgress();
    for(;fadeFrames<32&&!world.sourceScreen.fadeInDone();++fadeFrames){world.playerControls({});world.step({},false,false,.033f);
        if(world.scriptFault||world.scene.id!="ah05"||vm.field(world.game.ash,13).integer()<=0)throw std::runtime_error("AH06 return source fade frame failed");}
    if(!world.sourceScreen.fadeInDone()||world.lastOverlay.blackAlpha!=0)throw std::runtime_error("AH06 authored return fade did not reveal scene");
    std::cout<<"AH06 actual return fade progress"<<fadeStart<<"->"<<world.sourceScreen.fadeInProgress()<<" in"<<fadeFrames<<" source frames; alpha"<<unsigned(world.lastOverlay.blackAlpha)<<" HP"<<vm.field(world.game.ash,13).integer()<<" fuel"<<vm.field(saw,815).integer()<<'\n';
    const auto saved=world.saveStateBytes();
    auto cold=stageSavedWorld(world,saved);
    if(cold->saveStateBytes()!=saved||world.saveStateBytes()!=saved)throw std::runtime_error("AH06 actualreturncold differs");
    std::cout<<"AH06 actualwalk/fight/death604/rewards73+132/sourcevolume12queuedAH05(1,1,0)/coldPASS HP"<<vm.field(world.game.ash,13).integer()<<'\n';
}
