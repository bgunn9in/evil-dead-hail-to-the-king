    testEpisode(root,false,640,480,{},[](World& world){continueAH02WalkWorld(world);continueAH02HandleWalkWorld(world);continueAH05WalkWorld(world);continueCrowbarWalkWorld(world);continueAH05PlatformWalkWorld(world);continueAH10KeydoorWalkWorld(world);continueAH10PumpWalkWorld(world);continueAH12AmuletWalkWorld(world);continueAH12ReturnWalkWorld(world);continueAH06ArrivalWalkWorld(world);continueAH06MatriarchWalkWorld(world);});
}
