#pragma once
// Ordinary-input positives follow an explicitly labelled authored BM01 entry
// fixture, using source-created items and native stock (no earned-route claim).
// The separately named protocol cases deliberately edit object/inventory/FSM
// fixtures; they do not claim an earned campaign or a normal walking route.
namespace pickup_controls_test {
inline void require(bool yes,const char* message){if(!yes)throw std::runtime_error(std::string("Pickup controls: ")+message);}
struct Driver {
    std::unique_ptr<World> live;ControlSettings settings;ControlInput input;unsigned frames=0;
    explicit Driver(const fs::path& root):live(std::make_unique<World>(root,nullptr,presentMovieHeadless,true)){}
    World& w(){return *live;}
    int quantity(int identity)const{int result=0;for(int field:{98,99,100})for(const auto& i:live->game.items(field))if(i.itemID==identity)result+=i.quantity;return result;}
    int slot(int identity)const{for(const auto&[index,o]:live->nativeProperties.objects)if((o.flags&1)&&o.setup[0]==identity)return index;return -1;}
    Vec2 at()const{return {live->actor.position[0],live->actor.position[2]};}
    std::string owner()const{if(live->sourceGui.activeSystem<0)return {};const auto pad=SourceGui::at(live->sourceGui.systems,live->sourceGui.activeSystem).pad;return pad?live->game.package.classes.at(size_t(live->game.vm.objectClass(pad))).name:std::string{};}
    static void gui(World& world,const ControlFrame& f){for(const auto r:std::array<std::array<int,3>,10>{{
        {{int(ControlAction::PrimaryAttack),99,1}},{{int(ControlAction::Use),100,2}},{{int(ControlAction::SecondaryAttack),101,4}},{{int(ControlAction::Taunt),102,8}},
        {{int(ControlAction::TurnLeft),103,16}},{{int(ControlAction::TurnRight),104,32}},{{int(ControlAction::Forward),105,64}},{{int(ControlAction::Backward),106,128}},
        {{int(ControlAction::Pause),111,0x1000}},{{int(ControlAction::Inventory),112,0x2000}}}})if(f.pressed(ControlAction(r[0])))world.enqueueNativeInput(r[1],unsigned(r[2]));}
    void tick(Vec2 movement={},std::initializer_list<ControlAction> held={}){
        require(++frames<6000,"bounded ordinary-input fixture exceeded frame limit");ControlRawState raw;raw.gamepad=1;
        auto axis=[](float v){return Sint16(std::lround(std::clamp(v,-1.f,1.f)*(v>=0?32767:32768)));};raw.leftX=axis(movement.x);raw.leftY=axis(-movement.z);
        for(auto action:held){const auto& b=settings.binding(action);if(b.axes[0]!=SDL_GAMEPAD_AXIS_INVALID){if(b.axes[0]==SDL_GAMEPAD_AXIS_LEFT_TRIGGER)raw.leftTrigger=32767;else raw.rightTrigger=32767;}else if(b.buttons[0]!=SDL_GAMEPAD_BUTTON_INVALID)raw.buttons[size_t(b.buttons[0])]=true;else raw.keys[size_t(b.keys[0])]=true;}
        const auto f=input.update(settings,raw);w().sampleNativeController(f);const bool menu=w().sourceMenuOwnsInput();if(menu)gui(w(),f);else w().playerControls(f);
        w().step(f.movement,f.held(ControlAction::Run),!menu&&f.pressed(ControlAction::Use),.033f);require(!w().scriptFault,w().game.diagnostic.c_str());
        require(!processSourceCart(w()),"unexpected saved-state import through Cart");
        if(w().pendingSceneSwitch){const auto request=*w().pendingSceneSwitch;w().pendingSceneSwitch.reset();require(!edpackage::reload(request.sourceSceneId,request.destinationId),"fixture unexpectedly changed packages");require(w().switchScene(request,nullptr),"native scene transition failed");}
        if(w().takeNativeAimCancellation())input.cancelAimUntilRelease();w().takeNativeModeChange();
    }
    void wait(unsigned n){while(n--)tick();}
    void pulse(ControlAction action){tick({}, {action});tick();}
    void ready(){for(unsigned n=0;n<600;++n){
        if(w().sourceMenuOwnsInput()){if(owner()=="MenStart")pulse(ControlAction::Inventory);else if(owner()=="MenMain")pulse(ControlAction::PrimaryAttack);else pulse(ControlAction::Inventory);continue;}
        const auto& b=w().actors->at({0,0});auto& vm=w().game.vm;const bool armed=vm.field(w().game.ash,123).integer()!=0;
        if(w().game.mode==0&&!w().guard&&!(b.flags&0x48)&&!vm.field(w().game.ash,11).integer()&&!armed&&!vm.staticField(71).integer()&&b.actions.possible(115)&&!edlocomotion::manualAction(b.actions)&&w().nativeInputQueue.records.empty()){tick();return;}
        if(armed&&!vm.field(w().game.ash,11).integer()&&b.actions.possible(23)&&!w().modernAimHeld)tick({}, {ControlAction::Aim});else tick();
    }throw std::runtime_error("Pickup controls: source input did not settle");}
    Vec2 toward(Vec2 target)const{const auto& c=live->scene.cameras.at(live->actor.camera);const auto& l=live->actor.movement;const Vec2 r=l.held?l.right:c.right,f=l.held?l.forward:c.forward,d=target-at();const float determinant=r.x*f.z-r.z*f.x;require(std::abs(determinant)>.001f,"camera basis is singular");const Vec2 result{(d.x*f.z-d.z*f.x)/determinant,(r.x*d.z-r.z*d.x)/determinant};return length(result)>1e-6f?result*(1/length(result)):Vec2{};}
    void walk(Vec2 goal){float previous=1e20f;unsigned stalled=0;for(unsigned n=0;n<1200;++n){const float d=length(goal-at());if(d<.0485f){tick();ready();return;}stalled=d>=previous-.00001f?stalled+1:0;previous=d;if(stalled>=120){std::cout<<"Pickup fixture stall at="<<at().x<<','<<at().z<<" goal="<<goal.x<<','<<goal.z<<" camera="<<w().actor.camera<<" state="<<w().actors->at({0,0}).actions.layers[0].state<<'\n';require(false,"ordinary approach stalled");}if(d>.6f)tick(toward(goal),{ControlAction::Run});else tick(toward(goal));}throw std::runtime_error("Pickup controls: walking budget exceeded");}
    void face(Vec2 goal){float old=w().actor.yaw;unsigned still=0;tick();for(unsigned n=0;n<240;++n){const auto& b=w().actors->at({0,0});const float yaw=edactormath::modelYawFromHeading(std::atan2(double(goal.z-at().z),double(goal.x-at().x))),delta=float(std::remainder(double(yaw)-b.pose.yaw,double(edactormath::Tau)));if(std::abs(delta)<.14f){tick();return;}if(std::abs(std::remainder(double(b.pose.yaw)-old,double(edactormath::Tau)))<1e-7)++still;else still=0;old=b.pose.yaw;if(still>8){tick();still=0;}else {int leftSign=1;for(const auto& s:b.actions.states)for(const auto& r:s.transitions)if(r.action==7&&r.target<b.actions.states.size()){const auto callback=b.actions.states[r.target].callback;if(callback==1)leftSign=1;else if(callback==2)leftSign=-1;}tick({}, {(delta>0)==(leftSign>0)?ControlAction::TurnLeft:ControlAction::TurnRight});}}throw std::runtime_error("Pickup controls: native turning budget exceeded");}
    void restore(const std::vector<uint8_t>& bytes){w().restoreStateBytes(bytes);input.reset();wait(1);}
};
inline std::vector<uint8_t> ordinaryFar(const fs::path& root){Driver d(root/"levelB");require(d.w().scene.id=="bm01","requires original source-created BM01");
    // Source entry setup, not a live pose setter: the same authored marker0
    // used by the real A->B arrival. Subsequent movement is positive input only.
    const auto id=episode_portal_detail::sceneId(d.w().scene.id);require(d.w().switchScene({id,id,0,0,{{0,0,0}}},nullptr),"authored BM01 marker0 entry failed");d.input.reset();d.wait(3);d.ready();
    const int target=d.slot(112);require(target>=0,"authored BM01 tape112 missing");const auto& o=d.w().nativeProperties.objects.at(target);const Vec2 point{o.position.x,o.position.z};
    // Follow the retained ordinary route around the starting P1 obstacle;
    // its outer annulus endpoint is the genuine missed-pickup witness.
    std::cout<<"Pickup source entry="<<d.at().x<<','<<d.at().z<<" target="<<point.x<<','<<point.z<<" camera="<<d.w().actor.camera<<'\n';
    d.walk(point+Vec2{-1.2f,-1.8f});d.walk(point+Vec2{-1.25f,-1.25f});d.walk(point+Vec2{-.7777980566f,-1.164057732f});d.face(point);d.ready();const float distance=length(d.at()-point);require(distance>1.25f&&distance<1.5f,"outer-range ordinary approach changed");
    std::cout<<"Pickup ordinary BM01 approach: range="<<distance<<" frames="<<d.frames<<" owned="<<d.quantity(112)<<'\n';return d.w().saveStateBytes();}
inline void begin(Driver& d,int target){d.pulse(ControlAction::Use);for(unsigned n=0;n<12&&d.w().actors->cloneState().pickup.playback<0;++n)d.tick();const auto p=d.w().actors->cloneState().pickup;require(p.playback>=0&&p.target.index==target,"accepted native115 did not retain its actual selected target");const auto& play=d.w().actors->at({0,0}).actions.playbacks.at(size_t(p.playback));require(play.frame<17,"fixture missed pre-contact window");}
inline void positive(const fs::path& root,const std::vector<uint8_t>& base){Driver d(root/"levelB");d.restore(base);const int target=d.slot(112),before=d.quantity(112);begin(d,target);bool received=false;for(unsigned n=0;n<80;++n){d.tick();if(!received&&d.quantity(112)!=before){const auto& a=d.w().actors->at({0,0}).actions;const auto& layer=a.layers[0];require(d.quantity(112)==before+1&&layer.state==146&&layer.playback>=0&&a.playbacks[size_t(layer.playback)].frame==17,"far receipt moved away from original115 midpoint17");received=true;}}require(received&&d.quantity(112)==before+1&&!(d.w().nativeProperties.objects.at(target).flags&1),"far retained target was not received exactly once");d.ready();d.wait(20);require(d.quantity(112)==before+1,"pickup repeated after its animation completed");std::cout<<"Pickup ordinary far native115: selected tape112 received once after root retreat\n";}
inline void closer(const fs::path& root,const std::vector<uint8_t>& base){Driver d(root/"levelB");d.restore(base);const int target=d.slot(112),before=d.quantity(112);const auto& o=d.w().nativeProperties.objects.at(target);const Vec2 center{o.position.x,o.position.z},away=d.at()-center;d.walk(center+away*(.8f/length(away)));d.face(center);d.ready();begin(d,target);d.wait(60);require(d.quantity(112)==before+1&&!(d.w().nativeProperties.objects.at(target).flags&1),"closer native pickup changed");}
inline void extraObject(Driver& d){const int target=d.slot(112);auto duplicate=d.w().nativeProperties.objects.at(target);const Vec2 center{duplicate.position.x,duplicate.position.z},direction=center-d.at();duplicate.position.x=d.at().x+direction.x*(.4f/length(direction));duplicate.position.z=d.at().z+direction.z*(.4f/length(direction));d.w().nativeProperties.objects[31]=duplicate;}
inline void multipleProtocol(const fs::path& root,const std::vector<uint8_t>& base){Driver d(root/"levelB");d.restore(base);const int target=d.slot(112),before=d.quantity(112);extraObject(d);begin(d,target);d.wait(60);require(d.quantity(112)==before+1&&!(d.w().nativeProperties.objects.at(target).flags&1)&&(d.w().nativeProperties.objects.at(31).flags&1),"one pickup consumed a second eligible object");}
inline void resetObjectProtocol(Driver& d,int target,bool different){const auto original=d.w().nativeProperties.objects.at(target);auto setup=original.setup;if(different)setup[0]=169;d.w().game.vm.invoke(d.w().game.package.methodIndex("ed/base/External","objSetup","(IIIII)V"),0,{jpc::Value::integer(target),jpc::Value::integer(setup[0]),jpc::Value::integer(setup[1]),jpc::Value::integer(setup[2]),jpc::Value::integer(setup[3])});auto replacement=original;replacement.setup=setup;d.w().nativeProperties.objects[target]=replacement;}
inline void invalidationProtocols(const fs::path& root,const std::vector<uint8_t>& base){for(unsigned kind=0;kind<5;++kind){Driver d(root/"levelB");d.restore(base);const int target=d.slot(112),before=d.quantity(112);extraObject(d);begin(d,target);
    if(kind==0)d.w().nativeProperties.objects.at(target).flags&=~1;
    if(kind==1)d.w().nativeProperties.objects.at(target).position.x+=.01f;
    if(kind==2)resetObjectProtocol(d,target,false);
    if(kind==3)resetObjectProtocol(d,target,true);
    if(kind==4)d.w().actors->cancelPickup();
    d.wait(22);require(d.quantity(112)==before&&(d.w().nativeProperties.objects.at(31).flags&1),"invalid selected target fell back to a different eligible object");}
    std::cout<<"Pickup synthetic object protocols: inactive/moved/same-slot-reset/different-reset/cancel do not receive or choose replacement\n";}
inline void pendingResetProtocol(const fs::path& root,const std::vector<uint8_t>& base){Driver d(root/"levelB");d.restore(base);const int target=d.slot(112),before=d.quantity(112);extraObject(d);auto& w=d.w();const int selected=w.game.vm.invoke(w.game.package.methodIndex("ed/base/EDActor","getPickupObject","(I)I"),w.game.ash,{jpc::Value::integer(0)}).integer();require(selected==target,"protocol selected wrong source ordinal");resetObjectProtocol(d,target,false);require(w.actors->consoleAction({0,0},115),"protocol115 was rejected");const auto p=w.actors->cloneState().pickup;require(p.playback>=0&&p.target.index<0,"reset query did not retain a cancellation tombstone");d.wait(22);require(d.quantity(112)==before&&(w.nativeProperties.objects.at(31).flags&1),"same-tick reset-before-command picked a replacement");}
inline void interruptedProtocol(const fs::path& root,const std::vector<uint8_t>& base){Driver d(root/"levelB");d.restore(base);const int target=d.slot(112),before=d.quantity(112);begin(d,target);require(d.w().actors->consoleAction({0,0},39),"source completion39 interruption was rejected");d.wait(22);require(d.quantity(112)==before,"interrupted pickup received its item");}
inline void rejectedProtocol(const fs::path& root,const std::vector<uint8_t>& base){Driver d(root/"levelB");d.restore(base);const int before=d.quantity(112);require(d.w().actors->consoleAction({0,0},22),"protocol could not raise weapons");d.wait(40);require(d.w().actors->consoleAction({0,0},46),"protocol could not enter original Axe attack");require(!d.w().actors->at({0,0}).actions.possible(115),"protocol attack unexpectedly permits115");d.w().game.vm.invoke(d.w().game.package.methodIndex("ed/base/EDActor","getPickupObject","(I)I"),d.w().game.ash,{jpc::Value::integer(0)});require(!d.w().actors->consoleAction({0,0},115)&&d.w().actors->cloneState().pickup.playback<0,"rejected115 armed a pickup reservation");d.wait(22);require(d.quantity(112)==before,"rejected pickup received an item");}
inline void fullBagProtocol(const fs::path& root,const std::vector<uint8_t>& base){Driver d(root/"levelB");d.restore(base);auto& w=d.w();auto& vm=w.game.vm;const auto bag=vm.field(w.game.ash,99).reference();const auto slots=vm.arrayValues(vm.field(bag,w.game.hostField(HostFieldRole::InventorySlots)).reference());for(unsigned n=0;n<slots.size();++n)vm.invoke(w.game.package.methodIndex("Inventory","removeItemSlot","(I)I"),bag,{jpc::Value::integer(int(n))});
    for(int id:{3,4,5,6,7,8,14,24,34,46,50,51,56,69,70,91,105,119,161,202,203}){if(w.game.items(99).size()==slots.size())break;vm.invoke(w.game.package.methodIndex("Inventory","addItem","(II)I"),bag,{jpc::Value::integer(id),jpc::Value::integer(1)});}
    require(w.game.items(99).size()==slots.size()&&d.quantity(112)==0,"synthetic source-method full bag was not created");const int target=d.slot(112);begin(d,target);d.wait(24);require(d.quantity(112)==0&&(w.nativeProperties.objects.at(target).flags&1),"reservation bypassed original full-inventory rejection");}
inline void sceneVetoProtocol(const fs::path& root){Driver d(root);d.wait(3);d.ready();auto& w=d.w();auto& vm=w.game.vm;
    // Synthetic query/decision protocol: page75 uses SceneAB01's real veto.
    // The receiver is deliberately unattached; no scene progress is claimed.
    auto object=w.nativeProperties.objects.at(0);object.setup[0]=75;object.flags|=1;object.position.x=d.at().x+.5f;object.position.z=d.at().z;w.nativeProperties.objects[0]=object;
    require(vm.invoke(w.game.package.methodIndex("ed/base/EDActor","getPickupObject","(I)I"),w.game.ash,{jpc::Value::integer(0)}).integer()==0,"protocol page75 query was not selected");
    const auto veto=vm.makeObject(w.game.package.classIndex("SceneAB01"));const int decision=vm.invoke(w.game.package.methodIndex("SceneAB01","allowPickupItem","(LAsh;II)I"),veto,{jpc::Value::reference(w.game.ash),jpc::Value::integer(75),jpc::Value::integer(115)}).integer();require(decision==0,"native page75 scene-veto policy changed");
    if(decision>0)w.actors->consoleAction({0,0},decision);require(w.actors->cloneState().pickup.playback<0,"vetoed query armed a pickup");d.tick();require(w.actors->cloneState().pickup.query.index<0&&d.quantity(75)==0&&(w.nativeProperties.objects.at(0).flags&1),"vetoed source policy retained or granted a pickup");}
inline void deferredReceiptProtocol(const fs::path& root,const std::vector<uint8_t>& base){for(bool reset:{false,true}){Driver d(root/"levelB");d.restore(base);const int target=d.slot(112),before=d.quantity(112);begin(d,target);
    // Synthetic callback-busy protocol only: source ActorDB648 returns0 while
    // field11 is busy. No HP, damage, inventory, AI or position is changed.
    auto& w=d.w();w.game.vm.setField(w.game.ash,11,jpc::Value::integer(1));d.wait(22);
    const auto state=w.actors->cloneState();require(state.pickup.receiptPhase==1,"deferred event17 lost its selected fingerprint");require(std::any_of(state.callbacks.begin(),state.callbacks.end(),[](const auto& c){return c.listener==edactors::Key{0,0}&&c.message.event==17;}),"source648 did not defer the selected event17");require(d.quantity(112)==before,"busy callback granted its item early");
    if(reset){resetObjectProtocol(d,target,false);require(w.actors->cloneState().pickup.receiptPhase==2,"same-slot reset did not cancel the deferred receipt");}
    const auto saved=w.saveStateBytes();Driver cold(root/"levelB");cold.live=stageSavedWorld(w,saved);require(cold.w().saveStateBytes()==saved,"deferred event17 cold restore differs");d.input.reset();cold.input.reset();
    w.game.vm.setField(w.game.ash,11,jpc::Value::integer(0));cold.w().game.vm.setField(cold.w().game.ash,11,jpc::Value::integer(0));for(unsigned n=0;n<22;++n){d.tick();cold.tick();require(w.saveStateBytes()==cold.w().saveStateBytes(),"deferred event17 cold future differs");}
    require(w.actors->cloneState().pickup.receiptPhase==0,"completed deferred event17 retained its receipt");require(d.quantity(112)==before+(reset?0:1),"deferred event17 lost its item or received a reset slot");require(bool(w.nativeProperties.objects.at(target).flags&1)==reset,"deferred event17 changed wrong source object lifetime");}
    std::cout<<"Pickup synthetic busy648 retry: unchanged target once; reset target rejected; deferred cold/future exact\n";}
inline void saveRollback(const fs::path& root,const std::vector<uint8_t>& base){Driver d(root/"levelB");d.restore(base);const int target=d.slot(112),before=d.quantity(112);begin(d,target);d.wait(3);const auto saved=d.w().saveStateBytes();auto cold=stageSavedWorld(d.w(),saved);require(cold->saveStateBytes()==saved,"mid-pickup fullWorld cold restore differs");
    const auto script=d.w().game.checkpoint();const auto native=d.w().checkpointNative();resetObjectProtocol(d,target,false);require(d.w().actors->cloneState().pickup.target.index<0,"rollback fixture failed to cancel target");d.w().game.rollback(script);d.w().rollbackNative(native);require(d.w().saveStateBytes()==saved,"native checkpoint rollback lost the pickup reservation");
    Driver restored(root/"levelB");restored.w().restoreStateBytes(saved);restored.input.reset();d.input.reset();for(unsigned n=0;n<35;++n){d.tick();restored.tick();ControlFrame neutral;cold->sampleNativeController(neutral);const bool menu=cold->sourceMenuOwnsInput();if(!menu)cold->playerControls(neutral);cold->step({},false,false,.033f);cold->takeNativeAimCancellation();cold->takeNativeModeChange();require(d.w().saveStateBytes()==restored.w().saveStateBytes()&&d.w().saveStateBytes()==cold->saveStateBytes(),"saved reservation or rollback future differs");}
    require(d.quantity(112)==before+1&&restored.quantity(112)==before+1,"mid-pickup restore did not receive exactly one item");std::cout<<"Pickup mid-animation World save/cold/direct and native checkpoint rollback/future exact\n";}
}
void testPickupControlsWorld(const fs::path& root){using namespace pickup_controls_test;SDL_SetMainReady();checked(SDL_Init(SDL_INIT_GAMEPAD),"Native pickup controls regression");struct Quit{~Quit(){SDL_Quit();}} quit;std::cout<<std::unitbuf;const auto base=ordinaryFar(root);positive(root,base);closer(root,base);multipleProtocol(root,base);invalidationProtocols(root,base);pendingResetProtocol(root,base);interruptedProtocol(root,base);rejectedProtocol(root,base);fullBagProtocol(root,base);sceneVetoProtocol(root);deferredReceiptProtocol(root,base);saveRollback(root,base);std::cout<<"Pickup controls passed: ordinary selected-only receipt; explicit protocol negatives; saved target lifetime\n";}
